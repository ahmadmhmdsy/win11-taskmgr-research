<Window x:Class="TaskMgrClone.RunNewTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create new task" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFont}" FontSize="12">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                   Text="Type the name of a program, folder, document, or Internet resource, and Windows will open it for you." />

        <TextBox x:Name="CommandBox" Grid.Row="1" Height="32" Margin="0,14,0,12"
                 VerticalContentAlignment="Center" />

        <CheckBox x:Name="ElevatedCheck" Grid.Row="2"
                  Content="Create this task with administrative privileges" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Browse..." Padding="16,6" Margin="0,0,8,0" Click="OnBrowse" />
            <Button Content="OK" Padding="22,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" Padding="18,6" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
