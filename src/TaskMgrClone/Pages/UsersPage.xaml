<ui:PageBase x:Class="TaskMgrClone.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TaskMgrClone.UI">
    <ui:PageBase.Resources>
        <Style x:Key="UserCard" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="16,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UserMetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="UserMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </ui:PageBase.Resources>

    <Grid Margin="16,12,16,8">
        <ListBox x:Name="UsersList" Background="Transparent" BorderThickness="0" Padding="0"
                 SelectionMode="Single" ItemContainerStyle="{StaticResource UserCard}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- user name -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,12,0"
                                    Background="{DynamicResource SelectionBg}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                            <TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding UserName}" />
                        </StackPanel>

                        <!-- status + process count -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="42,7,0,0">
                            <TextBlock Text="{Binding StatusLine}" Style="{StaticResource SubtleText}" />
                            <TextBlock Text="{Binding ProcessLine}" Style="{StaticResource SubtleText}"
                                       Margin="18,0,0,0" />
                        </StackPanel>

                        <!-- metrics + actions -->
                        <Grid Grid.Row="2" Margin="42,13,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" MinWidth="56" />
                                    <ColumnDefinition Width="1.2*" MinWidth="74" />
                                    <ColumnDefinition Width="1.3*" MinWidth="82" />
                                    <ColumnDefinition Width="1.3*" MinWidth="82" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CPU" Style="{StaticResource UserMetricLabel}" />
                                    <TextBlock Text="{Binding CpuText}" Style="{StaticResource UserMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Memory" Style="{StaticResource UserMetricLabel}" />
                                    <TextBlock Text="{Binding MemoryText}" Style="{StaticResource UserMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Disk" Style="{StaticResource UserMetricLabel}" />
                                    <TextBlock Text="{Binding DiskText}" Style="{StaticResource UserMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Network" Style="{StaticResource UserMetricLabel}" />
                                    <TextBlock Text="{Binding NetworkText}" Style="{StaticResource UserMetricValue}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Disconnect" Style="{StaticResource ToolbarButton}"
                                        Click="OnDisconnect" />
                                <Button Content="Sign out" Style="{StaticResource ToolbarButton}"
                                        Click="OnSignOutClick" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
            <TextBlock Text="No other users are signed in" Margin="0,8,0,0" HorizontalAlignment="Center"
                       Style="{StaticResource SubtleText}" />
        </StackPanel>
    </Grid>
</ui:PageBase>
