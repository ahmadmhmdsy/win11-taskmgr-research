<ui:PageBase x:Class="TaskMgrClone.Pages.DetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TaskMgrClone.UI"
             Background="{DynamicResource ContentBg}"
             FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodySize}">
    <ui:PageBase.Resources>
        <ui:BytesConverter x:Key="Bytes" />
        <ui:PercentConverter x:Key="Percent" />
        <ui:RateConverter x:Key="Rate" />
        <ui:PowerUsageConverter x:Key="PowerUsage" />
        <ui:ProcessIconConverter x:Key="ProcessIcon" />

        <Style x:Key="TextCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="NumCell" TargetType="TextBlock" BasedOn="{StaticResource TextCell}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style x:Key="NumHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </ui:PageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="ProcessGrid" Grid.Row="0"
                  Background="Transparent" BorderThickness="0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False" CanUserReorderColumns="False"
                  RowHeight="28" ColumnHeaderHeight="32"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Sorting="OnSorting"
                  PreviewMouseRightButtonDown="OnGridPreviewMouseRightButtonDown"
                  MouseDoubleClick="OnGridMouseDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu Opened="OnContextMenuOpened">
                    <MenuItem x:Name="EndTaskMenu" Header="End task" Click="OnEndTaskMenu" />
                    <MenuItem x:Name="EndTreeMenu" Header="End process tree" Click="OnEndTreeMenu" />
                    <MenuItem x:Name="RestartMenu" Header="Restart" Click="OnRestartMenu" />
                    <Separator />
                    <MenuItem x:Name="PriorityMenu" Header="Set priority">
                        <MenuItem x:Name="PriorityRealtime" Header="Realtime" Tag="Realtime"
                                  IsCheckable="True" Click="OnSetPriority" />
                        <MenuItem x:Name="PriorityHigh" Header="High" Tag="High"
                                  IsCheckable="True" Click="OnSetPriority" />
                        <MenuItem x:Name="PriorityAboveNormal" Header="Above normal" Tag="Above normal"
                                  IsCheckable="True" Click="OnSetPriority" />
                        <MenuItem x:Name="PriorityNormal" Header="Normal" Tag="Normal"
                                  IsCheckable="True" Click="OnSetPriority" />
                        <MenuItem x:Name="PriorityBelowNormal" Header="Below normal" Tag="Below normal"
                                  IsCheckable="True" Click="OnSetPriority" />
                        <MenuItem x:Name="PriorityLow" Header="Low" Tag="Low"
                                  IsCheckable="True" Click="OnSetPriority" />
                    </MenuItem>
                    <MenuItem x:Name="AffinityMenu" Header="Set affinity" Click="OnSetAffinityMenu" />
                    <Separator />
                    <MenuItem x:Name="DumpMenu" Header="Create dump file" Click="OnCreateDumpMenu" />
                    <MenuItem x:Name="LocationMenu" Header="Open file location" Click="OnOpenFileLocationMenu" />
                    <MenuItem x:Name="OnlineMenu" Header="Search online" Click="OnSearchOnlineMenu" />
                    <Separator />
                    <MenuItem x:Name="PropertiesMenu" Header="Properties" Click="OnPropertiesMenu" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="NameColumn" Header="Name" Width="240"
                                        SortMemberPath="Name" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                                       Source="{Binding Row.Path, Converter={StaticResource ProcessIcon}}" />
                                <TextBlock Text="{Binding Row.Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Row.Path}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="PID" Width="64" SortMemberPath="Pid"
                                    Binding="{Binding Row.Pid}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Status" Width="78" SortMemberPath="Status"
                                    Binding="{Binding Status}"
                                    ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="User name" Width="132" SortMemberPath="User"
                                    Binding="{Binding Row.UserName}"
                                    ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="CPU" Width="62" SortMemberPath="Cpu"
                                    Binding="{Binding Row.CpuPercent, Converter={StaticResource Percent}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Memory" Width="92" SortMemberPath="Memory"
                                    Binding="{Binding Row.WorkingSetBytes, Converter={StaticResource Bytes}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Commit size" Width="92" SortMemberPath="Commit"
                                    Binding="{Binding Row.CommitBytes, Converter={StaticResource Bytes}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Paged pool" Width="88" SortMemberPath="PagedPool"
                                    Binding="{Binding Row.PagedPoolBytes, Converter={StaticResource Bytes}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="NP pool" Width="88" SortMemberPath="NonPagedPool"
                                    Binding="{Binding Row.NonPagedPoolBytes, Converter={StaticResource Bytes}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Page faults" Width="96" SortMemberPath="PageFaults"
                                    Binding="{Binding Row.PageFaults, StringFormat='{}{0:N0}'}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="PF Delta" Width="80" SortMemberPath="PfDelta"
                                    Binding="{Binding PfDelta, StringFormat='{}{0:N0}'}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Base priority" Width="88" SortMemberPath="BasePriority"
                                    Binding="{Binding Row.BasePriority}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Handles" Width="70" SortMemberPath="Handles"
                                    Binding="{Binding Row.HandleCount}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Threads" Width="70" SortMemberPath="Threads"
                                    Binding="{Binding Row.ThreadCount}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="User objects" Width="88" SortMemberPath="UserObjects"
                                    Binding="{Binding Row.UserObjects}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="GDI objects" Width="88" SortMemberPath="GdiObjects"
                                    Binding="{Binding Row.GdiObjects}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="I/O read" Width="88" SortMemberPath="IoRead"
                                    Binding="{Binding Row.IoReadBytes, Converter={StaticResource Bytes}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="I/O write" Width="88" SortMemberPath="IoWrite"
                                    Binding="{Binding Row.IoWriteBytes, Converter={StaticResource Bytes}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="I/O other" Width="88" SortMemberPath="IoOther"
                                    Binding="{Binding Row.IoOtherBytes, Converter={StaticResource Bytes}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Disk" Width="88" SortMemberPath="Disk"
                                    Binding="{Binding Row.DiskBytesPerSec, Converter={StaticResource Rate}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="GPU" Width="62" SortMemberPath="Gpu"
                                    Binding="{Binding Row.GpuPercent, Converter={StaticResource Percent}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="GPU dedicated memory" Width="132" SortMemberPath="GpuMemory"
                                    Binding="{Binding Row.GpuDedicatedBytes, Converter={StaticResource Bytes}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Power usage" Width="96" SortMemberPath="Power"
                                    Binding="{Binding Row.PowerUsage, Converter={StaticResource PowerUsage}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Power usage trend" Width="122" SortMemberPath="PowerTrend"
                                    Binding="{Binding Row.PowerUsageTrend, Converter={StaticResource PowerUsage}}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Height="30" Padding="12,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="CountText" Text="0 processes" VerticalAlignment="Center"
                       Style="{StaticResource SubtleText}" />
        </Border>
    </Grid>
</ui:PageBase>
