<ui:PageBase x:Class="TaskMgrClone.Pages.PerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TaskMgrClone.UI"
             xmlns:controls="clr-namespace:TaskMgrClone.Controls"
             Background="{DynamicResource ContentBg}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== left resource list ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource ContentBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,6,0,6">
                    <StackPanel x:Name="TileHost" />
                </ScrollViewer>

                <Button Grid.Row="1" x:Name="ResourceMonitorLink" Click="OnOpenResourceMonitor"
                        HorizontalAlignment="Left" Margin="8,4,8,8" Padding="6,4"
                        ToolTip="Open Resource Monitor">
                    <TextBlock Text="Open Resource Monitor" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- ===================== right detail pane ===================== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,18,28,16">

                <!-- ============================ CPU ============================ -->
                <StackPanel x:Name="CpuPanel">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CPU" Style="{StaticResource BigValue}" VerticalAlignment="Center" />
                        <TextBlock x:Name="CpuModelText" Grid.Column="1" Style="{StaticResource SubtleText}"
                                   VerticalAlignment="Bottom" Margin="12,0,0,5" MaxWidth="380"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid x:Name="CpuGraphHost" Height="140" Margin="0,0,0,22" Background="Transparent">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Change graph to">
                                    <MenuItem x:Name="CpuGraphOverallMenu" Header="Overall utilization"
                                              IsCheckable="True" IsChecked="True" Click="OnCpuGraphOverall" />
                                    <MenuItem x:Name="CpuGraphLogicalMenu" Header="Logical processors"
                                              IsCheckable="True" Click="OnCpuGraphLogical" />
                                </MenuItem>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <controls:AreaGraph x:Name="CpuArea" />
                        <controls:CpuHeatmap x:Name="CpuHeat" Visibility="Collapsed" />
                    </Grid>

                    <UniformGrid x:Name="CpuStatsHost" Columns="3" />
                </StackPanel>

                <!-- ============================ Memory ============================ -->
                <StackPanel x:Name="MemoryPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Memory" Style="{StaticResource BigValue}" VerticalAlignment="Center" />
                        <TextBlock x:Name="MemTotalText" Grid.Column="1" Style="{StaticResource SubtleText}"
                                   VerticalAlignment="Bottom" Margin="12,0,0,5" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Height="140" Margin="0,0,0,18">
                        <controls:AreaGraph x:Name="MemoryArea" />
                    </Grid>

                    <controls:CompositionBar x:Name="MemoryComposition" Height="10" Margin="0,0,0,10" />
                    <WrapPanel x:Name="MemoryLegend" Margin="0,0,0,20" />

                    <UniformGrid x:Name="MemoryStatsHost" Columns="3" />
                </StackPanel>

                <!-- ============================ Disk ============================ -->
                <StackPanel x:Name="DiskPanel" Visibility="Collapsed">
                    <TextBlock x:Name="DiskTitleText" Style="{StaticResource BigValue}" Margin="0,0,0,14"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                    <Grid Height="140" Margin="0,0,0,22">
                        <controls:AreaGraph x:Name="DiskArea" />
                    </Grid>

                    <UniformGrid x:Name="DiskStatsHost" Columns="3" />
                </StackPanel>

                <!-- ============================ Network ============================ -->
                <StackPanel x:Name="NetworkPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NetTitleText" Style="{StaticResource BigValue}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NetKindText" Grid.Column="1" Style="{StaticResource SubtleText}"
                                   VerticalAlignment="Bottom" Margin="12,0,0,5" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Height="140" Margin="0,0,0,22">
                        <controls:AreaGraph x:Name="NetArea" />
                    </Grid>

                    <UniformGrid x:Name="NetStatsHost" Columns="3" />
                </StackPanel>

                <!-- ============================ GPU ============================ -->
                <StackPanel x:Name="GpuPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GpuTitleText" Style="{StaticResource BigValue}" VerticalAlignment="Center" />
                        <TextBlock x:Name="GpuAdapterText" Grid.Column="1" Style="{StaticResource SubtleText}"
                                   VerticalAlignment="Bottom" Margin="12,0,0,5" MaxWidth="380"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 3D -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,1,5,0" />
                                    <TextBlock Text="3D" Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <TextBlock x:Name="Gpu3DPercent" Grid.Column="1" Text="0%" Style="{StaticResource SubtleText}" />
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource ListBg}" Height="86">
                                <controls:MiniGraph x:Name="Gpu3DGraph" />
                            </Border>
                        </StackPanel>

                        <!-- Copy -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,1,5,0" />
                                    <TextBlock Text="Copy" Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <TextBlock x:Name="GpuCopyPercent" Grid.Column="1" Text="0%" Style="{StaticResource SubtleText}" />
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource ListBg}" Height="86">
                                <controls:MiniGraph x:Name="GpuCopyGraph" />
                            </Border>
                        </StackPanel>

                        <!-- Video Encode -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,1,5,0" />
                                    <TextBlock Text="Video Encode" Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <TextBlock x:Name="GpuEncodePercent" Grid.Column="1" Text="0%" Style="{StaticResource SubtleText}" />
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource ListBg}" Height="86">
                                <controls:MiniGraph x:Name="GpuEncodeGraph" />
                            </Border>
                        </StackPanel>

                        <!-- Video Decode -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,1,5,0" />
                                    <TextBlock Text="Video Decode" Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <TextBlock x:Name="GpuDecodePercent" Grid.Column="1" Text="0%" Style="{StaticResource SubtleText}" />
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource ListBg}" Height="86">
                                <controls:MiniGraph x:Name="GpuDecodeGraph" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dedicated GPU memory" Style="{StaticResource MetricLabel}" />
                            <TextBlock x:Name="GpuDedicatedText" Grid.Column="1" Style="{StaticResource MetricLabel}" />
                        </Grid>
                        <controls:PercentBar x:Name="GpuDedicatedBar" Height="6" Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Shared GPU memory" Style="{StaticResource MetricLabel}" />
                            <TextBlock x:Name="GpuSharedText" Grid.Column="1" Style="{StaticResource MetricLabel}" />
                        </Grid>
                        <controls:PercentBar x:Name="GpuSharedBar" Height="6" Margin="0,5,0,0" />
                    </StackPanel>

                    <UniformGrid x:Name="GpuStatsHost" Columns="3" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:PageBase>