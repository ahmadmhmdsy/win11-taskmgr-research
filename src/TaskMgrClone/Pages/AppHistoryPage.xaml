<ui:PageBase x:Class="TaskMgrClone.Pages.AppHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TaskMgrClone.UI">
    <ui:PageBase.Resources>
        <ui:ProcessIconConverter x:Key="ProcessIcon" />

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>

        <Style x:Key="NumericHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </ui:PageBase.Resources>

    <Grid Margin="16,10,16,10">
        <DataGrid x:Name="HistoryGrid" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                  RowHeight="32" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Delete" Click="OnDeleteSelected" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="400" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding IconPath, Converter={StaticResource ProcessIcon}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="CPU time" Width="150" SortMemberPath="CpuTime"
                                    Binding="{Binding CpuTimeText}"
                                    ElementStyle="{StaticResource CellTextRight}"
                                    HeaderStyle="{StaticResource NumericHeader}" />

                <DataGridTextColumn Header="Network" Width="150" SortMemberPath="NetworkBytes"
                                    Binding="{Binding NetworkText}"
                                    ElementStyle="{StaticResource CellTextRight}"
                                    HeaderStyle="{StaticResource NumericHeader}" />

                <DataGridTextColumn Header="Tile updates" Width="150" SortMemberPath="TileUpdates"
                                    Binding="{Binding TileUpdatesText}"
                                    ElementStyle="{StaticResource CellTextRight}"
                                    HeaderStyle="{StaticResource NumericHeader}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
            <TextBlock Text="No app usage history yet" Margin="0,8,0,0" HorizontalAlignment="Center"
                       Style="{StaticResource SubtleText}" />
            <TextBlock Text="CPU time, network usage and tile updates appear here as you use apps."
                       Margin="0,2,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}"
                       FontSize="11" />
        </StackPanel>
    </Grid>
</ui:PageBase>
