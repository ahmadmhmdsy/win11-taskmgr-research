<ui:PageBase x:Class="TaskMgrClone.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TaskMgrClone.UI">
    <ui:PageBase.Resources>
        <ui:ProcessIconConverter x:Key="ProcessIcon" />

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </ui:PageBase.Resources>

    <Grid Margin="16,10,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="StartupGrid" Grid.Row="0" IsReadOnly="True" SelectionMode="Extended"
                  SelectionUnit="FullRow" RowHeight="32"
                  PreviewMouseRightButtonDown="OnGridPreviewRightButtonDown"
                  MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu Opened="OnStartupContextMenuOpened">
                    <MenuItem Header="Disable" Click="OnContextToggle" />
                    <Separator />
                    <MenuItem Header="Open file location" Click="OnContextOpenLocation" />
                    <MenuItem Header="Search online" Click="OnContextSearchOnline" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="380" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding ExecutablePath, Converter={StaticResource ProcessIcon}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Publisher" Width="240" SortMemberPath="Publisher"
                                    Binding="{Binding Publisher}" ElementStyle="{StaticResource CellText}" />

                <DataGridTextColumn Header="Status" Width="110" SortMemberPath="Status"
                                    Binding="{Binding Status}" ElementStyle="{StaticResource CellText}" />

                <DataGridTextColumn Header="Startup impact" Width="140" SortMemberPath="Impact"
                                    Binding="{Binding Impact}" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel x:Name="EmptyPanel" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
            <TextBlock Text="No startup apps found" Margin="0,8,0,0" HorizontalAlignment="Center"
                       Style="{StaticResource SubtleText}" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,1,0,0"
                Padding="2,9,2,9">
            <TextBlock x:Name="BiosText" Style="{StaticResource SubtleText}" HorizontalAlignment="Right"
                       Text="Last BIOS time: N/A" />
        </Border>
    </Grid>
</ui:PageBase>
