<ui:PageBase x:Class="TaskMgrClone.Pages.ServicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TaskMgrClone.UI"
             Background="{DynamicResource ContentBg}"
             FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodySize}">
    <ui:PageBase.Resources>
        <Style x:Key="TextCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="NumCell" TargetType="TextBlock" BasedOn="{StaticResource TextCell}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style x:Key="NumHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </ui:PageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="ServiceGrid" Grid.Row="0"
                  Background="Transparent" BorderThickness="0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False" CanUserReorderColumns="False"
                  RowHeight="28" ColumnHeaderHeight="32"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Sorting="OnSorting"
                  PreviewMouseRightButtonDown="OnGridPreviewMouseRightButtonDown"
                  MouseDoubleClick="OnGridMouseDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu Opened="OnContextMenuOpened">
                    <MenuItem x:Name="StartMenu" Header="Start" Click="OnStartMenu" />
                    <MenuItem x:Name="StopMenu" Header="Stop" Click="OnStopMenu" />
                    <MenuItem x:Name="RestartMenu" Header="Restart" Click="OnRestartMenu" />
                    <Separator />
                    <MenuItem Header="Open Services" Click="OnOpenServicesMenu" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn x:Name="NameColumn" Header="Name" Width="220" SortMemberPath="Name"
                                    Binding="{Binding Name}"
                                    ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="PID" Width="70" SortMemberPath="Pid"
                                    Binding="{Binding Pid}"
                                    ElementStyle="{StaticResource NumCell}"
                                    HeaderStyle="{StaticResource NumHeader}" />
                <DataGridTextColumn Header="Description" Width="440" SortMemberPath="Description"
                                    Binding="{Binding Description}"
                                    ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="Status" Width="112" SortMemberPath="Status"
                                    Binding="{Binding Status}"
                                    ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="Group" Width="150" SortMemberPath="Group"
                                    Binding="{Binding Group}"
                                    ElementStyle="{StaticResource TextCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Height="30" Padding="12,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="CountText" Text="0 services" VerticalAlignment="Center"
                       Style="{StaticResource SubtleText}" />
        </Border>
    </Grid>
</ui:PageBase>
