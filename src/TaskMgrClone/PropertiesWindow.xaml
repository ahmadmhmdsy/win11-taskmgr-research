<Window x:Class="TaskMgrClone.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFont}" FontSize="12">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Name" Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NameText" Margin="0,3" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="Publisher" Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PublisherText" Margin="0,3" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Text="Description" Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DescriptionText" Margin="0,3" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Text="Version" Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="VersionText" Margin="0,3" TextWrapping="Wrap" />
            <TextBlock Grid.Row="4" Text="PID" Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="PidText" Margin="0,3" />
            <TextBlock Grid.Row="5" Text="User" Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="UserText" Margin="0,3" TextWrapping="Wrap" />
            <TextBlock Grid.Row="6" Text="Started" Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="StartedText" Margin="0,3" />
            <TextBlock Grid.Row="7" Text="Location" Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="PathText" Margin="0,3" TextWrapping="Wrap" />
            <TextBlock Grid.Row="8" Text="Command line" Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="CommandText" Margin="0,3" TextWrapping="Wrap" MaxHeight="90" />
            <TextBlock Grid.Row="9" Text="Type" Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
            <TextBlock Grid.Row="9" Grid.Column="1" x:Name="TypeText" Margin="0,3" />
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open file location" Padding="14,6" Margin="0,0,8,0" Click="OnOpenLocation" />
            <Button Content="Search online" Padding="14,6" Margin="0,0,8,0" Click="OnSearchOnline" />
            <Button Content="OK" Padding="24,6" IsDefault="True" IsCancel="True" Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
